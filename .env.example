# ===========================================
# virtual-clinic - Variables de entorno
# Copiar a .env y completar valores reales
# ===========================================

# Base de datos
POSTGRES_DB=virtual_clinic
POSTGRES_USER=virtual_clinic
POSTGRES_PASSWORD=cambiar_por_password_seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Seguridad (OBLIGATORIO cambiar en producción)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_por_clave_secreta_minimo_32_caracteres

# Entorno
ENVIRONMENT=production

# Cookies
COOKIE_SECURE=true
ACCESS_TOKEN_COOKIE_NAME=access_token
ACCESS_TOKEN_COOKIE_SAMESITE=lax
ACCESS_TOKEN_COOKIE_PATH=/
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (separados por coma)
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Algoritmo JWT
ALGORITHM=HS256

# Almacenamiento
STORAGE_DIR=/app/storage

# PDF
PDF_FOOTER_LEGEND=Indicacion medica

# Archivos
MAX_FILE_SIZE_MB=10

# Visibilidad historia clínica para paciente
PATIENT_VISIBLE_NOTES=false

# Rate limiting
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# ===========================================
# Desarrollo (descomentar para desarrollo local)
# ===========================================
# ENVIRONMENT=development
# COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQL_ECHO=true