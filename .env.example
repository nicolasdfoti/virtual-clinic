# ---------------------------------------------------------------------------
#Raiz. Copiar a .env y completar. Lo usa docker-compose.yml.
#
#   Windows (PowerShell):  copy .env.example .env
#   Linux/macOS:          cp .env.example .env
#
# Estos valores son los del CONTENEDOR de Postgres, no los del backend: si los
# cambias, actualizá también DATABASE_URL en backend/.env.
# ---------------------------------------------------------------------------

POSTGRES_DB=virtual_clinic
POSTGRES_USER=clinic_user

# Contraseña de la base. Generar una real en lugar de usar `change_me`.
POSTGRES_PASSWORD=change_me

# Puerto del host donde se publica Postgres. Cambiarlo si el 5432 esta ocupado.
POSTGRES_PORT=5432

# --- pgAdmin ----------------------------------------------------------------

# Solo para desarrollo. pgAdmin queda expuesto en localhost y SIN autenticacion
# por defecto: no publicarlo en un puerto de internet.
PGADMIN_EMAIL=admin@example.com

# Contraseña de pgAdmin. Tiene que ser distinta de POSTGRES_PASSWORD.
PGADMIN_PASSWORD=change_me

# Puerto del host donde se publica pgAdmin.
PGADMIN_PORT=5050