# ---------------------------------------------------------------------------
# Frontend. Copiar a frontend/.env y completar.
#
#   Windows (PowerShell):  copy .env.example .env
#   Linux/macOS:          cp .env.example .env
#
# Ojo: Vite solo expone al bundle las variables con prefijo VITE_, y quedan
# visibles en el JavaScript del navegador. Jamás poner un secreto acá.
# ---------------------------------------------------------------------------

# Base de la API, incluido el prefijo /api que usa el backend.
VITE_API_URL=http://localhost:8000/api