# Auth: migracion de passlib+python-jose a pwdlib (argon2) + PyJWT
# pwdlib usa argon2id por defecto, PyJWT es el standard para JWT.
# El extra [argon2] trae argon2-cffi, que publica wheels con la libargon2
# embebida: no hace falta instalar nada via apt ni compilar extensiones.
# El extra [bcrypt] mantiene la verificacion de hashes legacy (rehashing
# transparente al login); bcrypt publica wheels para Linux y Windows.
pwdlib[argon2,bcrypt]==0.3.1
pyjwt==2.15.1

