# ---------------------------------------------------------------------------
# Backend. Copiar a backend/.env y completar.
#
#   Windows (PowerShell):  copy .env.example .env
#   Linux/macOS:          cp .env.example .env
#
# `.env` esta en .gitignore: nunca commitearlo.
# ---------------------------------------------------------------------------

# --- Base de datos ----------------------------------------------------------

# Debe coincidir con POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD del
# `.env` de la raiz (el que usa docker compose).
DATABASE_URL=postgresql+psycopg://clinic_user:change_me@localhost:5432/virtual_clinic

# --- Seguridad --------------------------------------------------------------

# OBLIGATORIA, minimo 32 caracteres: si falta o es muy corta la app no arranca.
#
# El valor de abajo es un placeholder INVENTADO y la app lo rechaza: para
# generar una real, desde backend/ con el venv activado:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
SECRET_KEY=change_me_genera_una_real_con_secrets_token_urlsafe

# development | testing | production
ENVIRONMENT=development

# La cookie de sesion solo viaja por HTTPS cuando esto es true. En produccion
# se fuerza a true automaticamente, asi que no hace falta tocarlo ahi.
# En dev (http://localhost) tiene que quedar false.
COOKIE_SECURE=false

# --- HTTP -------------------------------------------------------------------

# Origenes permitidos por CORS, separados por coma. Son los que autoriza Vite.
CORS_ORIGINS=http://localhost:5173

# Loguear cada consulta SQL. En desarrollo ayuda; nunca en produccion.
SQL_ECHO=false

# --- Sesion -----------------------------------------------------------------

# Duracion de la cookie / del JWT, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Tests ------------------------------------------------------------------

# Base que usa pytest. Si no se define, la suite corre en SQLite en memoria.
# El punto es que NUNCA apunte a la base de desarrollo: los tests borran
# todas las tablas entre casos.
#
# TEST_DATABASE_URL=postgresql+psycopg://clinic_user:change_me@localhost:5432/virtual_clinic_test